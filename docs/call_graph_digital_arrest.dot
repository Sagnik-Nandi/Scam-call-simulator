digraph call {
  rankdir=TB; nodesep=0.45; ranksep=0.55; fontname="Helvetica";
  node [fontname="Helvetica" fontsize=11 style=filled margin="0.12,0.07"];
  edge [fontname="Helvetica" fontsize=9];
  labelloc=t; fontsize=15; label="Digital arrest call: how the call moves (blue = friendly helper, yellow = asking for the OTP, orange = pressure)";
  greet [label="greet\n[authority]" fillcolor="#dbeafe" shape=box style="rounded,filled"];
  parcel [label="parcel\n[fear, authority]" fillcolor="#dbeafe" shape=box style="rounded,filled"];
  isolate [label="isolate\n[secrecy, false_help]" fillcolor="#dbeafe" shape=box style="rounded,filled"];
  verify [label="verify\n[authority]" fillcolor="#dbeafe" shape=box style="rounded,filled"];
  warn_station [label="warn_station\n[fear, authority]\n(used at most 1 time)\n(remembers the interrupted step)" fillcolor="#ffd9b3" shape=box style="rounded,filled"];
  warn_case [label="warn_case\n[fear, urgency]\n(used at most 1 time)\n(remembers the interrupted step)" fillcolor="#ffd9b3" shape=box style="rounded,filled"];
  pushback [label="pushback\n[fear, secrecy]\n(remembers the interrupted step)" fillcolor="#ffd9b3" shape=box style="rounded,filled"];
  final_early [label="final_early\n[urgency, fear]\n(used at most 1 time)\n(remembers the interrupted step)" fillcolor="#ffd9b3" shape=box style="rounded,filled"];
  otp_demand [label="otp_demand\n[credential_request]\n(OTP card shown)" fillcolor="#fff3b0" shape=box style="rounded,filled"];
  otp_soft [label="otp_soft\n[false_help, credential_request]\n(OTP card shown)" fillcolor="#fff3b0" shape=box style="rounded,filled"];
  otp_pressure [label="otp_pressure\n[fear, secrecy, credential_request]\n(OTP card shown)" fillcolor="#ffd9b3" shape=box style="rounded,filled"];
  final_warning [label="final_warning\n[urgency, fear]\n(OTP card shown)" fillcolor="#ffd9b3" shape=box style="rounded,filled"];
  end_lose [label="END: lose" fillcolor="#f8d7da" shape=doublecircle fontsize=11];
  end_win [label="END: win" fillcolor="#d4edda" shape=doublecircle fontsize=11];
  RESUME [label="PROCEED\nthe step that would have\nfollowed the interrupted one\n(agree / no match)" shape=diamond fillcolor="#e9ecef" fontsize=10];
  start [label="call starts" shape=plaintext style=""]; start -> greet;
  greet -> parcel [label="agree / no match\nrefuse / doubt"];
  parcel -> isolate [label="agree / no match"];
  parcel -> warn_station [label="refuse / doubt"];
  isolate -> verify [label="agree / no match"];
  isolate -> warn_station [label="refuse / doubt"];
  verify -> otp_demand [label="agree / no match"];
  verify -> warn_station [label="refuse / doubt"];
  warn_station -> RESUME [label="agree / no match" style=dashed color="#555555"];
  warn_station -> warn_case [label="refuse / doubt"];
  warn_station -> warn_case [label="already used" style=dotted color="#b35900" fontcolor="#b35900"];
  warn_case -> RESUME [label="agree / no match" style=dashed color="#555555"];
  warn_case -> pushback [label="refuse / doubt"];
  warn_case -> pushback [label="already used" style=dotted color="#b35900" fontcolor="#b35900"];
  pushback -> RESUME [label="agree / no match" style=dashed color="#555555"];
  pushback -> final_early [label="refuse / doubt"];
  final_early -> RESUME [label="agree / no match" style=dashed color="#555555"];
  final_early -> end_win [label="refuse / doubt"];
  final_early -> end_win [label="already used" style=dotted color="#b35900" fontcolor="#b35900"];
  otp_demand -> end_lose [label="says the OTP" color="#b00020"];
  otp_demand -> otp_soft [label="refuse / doubt\nno match"];
  otp_demand -> otp_demand [label="agree: asks again\n(up to 1 times, then counted as a refusal)" style=dashed color="#888888"];
  otp_soft -> end_lose [label="says the OTP" color="#b00020"];
  otp_soft -> otp_pressure [label="refuse / doubt\nno match"];
  otp_soft -> otp_soft [label="agree: asks again\n(up to 1 times, then counted as a refusal)" style=dashed color="#888888"];
  otp_pressure -> end_lose [label="says the OTP" color="#b00020"];
  otp_pressure -> final_warning [label="refuse / doubt\nno match"];
  otp_pressure -> otp_pressure [label="agree: asks again\n(up to 1 times, then counted as a refusal)" style=dashed color="#888888"];
  final_warning -> end_lose [label="says the OTP" color="#b00020"];
  final_warning -> end_win [label="refuse / doubt\nno match"];
  final_warning -> final_warning [label="agree: asks again\n(up to 1 times, then counted as a refusal)" style=dashed color="#888888"];
  RESUME -> parcel [style=dashed color="#555555"];
  RESUME -> isolate [style=dashed color="#555555"];
  RESUME -> verify [style=dashed color="#555555"];
  RESUME -> otp_demand [style=dashed color="#555555"];
  notes [shape=note fillcolor="#f1f3f5" fontsize=10 label="Replies that do not follow the normal branches:\l - confused: the caller explains the same step (up to 1 time);\l   asking again counts as a refusal and the call moves on\l - question (ask identity, ask location, ask proof, ask info):\l   answered in character, same step; at most 3 in the whole call\l - stall (wait / hold on): at most 2 answers; scared: at most 2 answers\l   going over any of these caps counts as a refusal (pushback in the early script)\l - unrecognised, 3+ words: not asked again, the caller carries on (no-match branch)\l - unrecognised, shorter: asks Sorry, I did not catch that (up to 1 time), then the no-match branch\l - silence 2 times in a row: call ends (idle); any speech resets the count\l - hang up, at any step: call ends (win)\l"];
}